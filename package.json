{
  "name": "bound-ledger",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin385/bound-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/kevin385/bound-ledger/issues"
  },
  "homepage": "https://github.com/kevin385/bound-ledger#readme",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @bound/cli dev",
    "start": "pnpm --filter @bound/cli start",
    "demo:ledger-read": "pnpm --filter @bound/cli demo:ledger-read",
    "demo:ledger-confirmation": "pnpm --filter @bound/cli demo:ledger-confirmation",
    "demo:ledger-agent": "pnpm --filter @bound/cli demo:ledger-agent",
    "dev:personal-ledger": "pnpm --filter @bound/personal-ledger dev",
    "build:personal-ledger": "pnpm --filter @bound/personal-ledger build",
    "test:e2e": "pnpm --filter @bound/personal-ledger test:e2e",
    "eval:general-ledger": "pnpm --filter @bound/cli eval:general-ledger",
    "test": "pnpm -r --if-present test && pnpm test:sandbox",
    "test:sandbox": "node --no-node-snapshot --test experiments/sandbox/*.test.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "isolated-vm": "7.0.1",
    "quickjs-emscripten": "catalog:"
  }
}
